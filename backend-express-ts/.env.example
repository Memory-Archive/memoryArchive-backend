PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=memory_app
# Same value as MYSQL_PASSWORD in ../.env (used by docker-compose)
DB_PASSWORD=
DB_NAME=memory_archive

REDIS_URL=redis://localhost:6379

# Secret used to sign access tokens (HS256). At least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
# Durations: <number><s|m|h|d>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
